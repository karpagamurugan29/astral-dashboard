{
    "installCommand": "npm install --legacy-peer-deps",
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "index.js"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/audit-timers",
            "schedule": "30 13 * * *"
        },
        {
            "path": "/api/cron/auto-checkout",
            "schedule": "30 14 * * *"
        }
    ]
}
